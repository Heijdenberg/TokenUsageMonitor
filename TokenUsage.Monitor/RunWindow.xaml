<Window x:Class="TokenUsage.Monitor.RunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Körning" Width="1000" Height="720" MinWidth="480" MinHeight="220"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Background}" Foreground="{StaticResource Text}" FontFamily="{StaticResource UiFont}" FontWeight="{StaticResource UiWeight}" FontSize="14" Language="sv-SE">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <!-- Fallback frame for Windows 10; on Windows 11 the system draws a rounded border instead. -->
    <Border x:Name="WindowFrame" BorderBrush="{StaticResource Accent}" BorderThickness="1">
        <!-- Like the prompt window: a yellow title bar, and the content's rounded top corners show it. -->
        <Grid Background="{StaticResource Accent}">
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- The title bar is the caption, so the window can be dragged by it. -->
            <StackPanel VerticalAlignment="Center" Margin="20,0">
                <TextBlock x:Name="Heading" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Background}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="Details" FontSize="13" Foreground="{StaticResource Background}" Opacity="0.75" Margin="0,2,0,0"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <Border Grid.Row="1" Background="{StaticResource Background}" CornerRadius="10,10,0,0">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" MaxHeight="260"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- How the run's agents and models split the cost. -->
                    <ContentControl Style="{StaticResource OutlineCard}" Padding="6,10,6,6">
                        <DataGrid x:Name="Agents">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Agent" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource PromptCell}"/>
                                <DataGridTextColumn Header="Modell" Binding="{Binding Model}" ElementStyle="{StaticResource ModelCell}"/>
                                <DataGridTextColumn Header="Svar" Binding="{Binding Responses, StringFormat=N0}" ElementStyle="{StaticResource Number}"/>
                                <DataGridTextColumn Header="In" Binding="{Binding Input, StringFormat=N0}" ElementStyle="{StaticResource MutedNumber}"/>
                                <DataGridTextColumn Header="Utskrivet" Binding="{Binding Output, StringFormat=N0}" ElementStyle="{StaticResource Number}"/>
                                <DataGridTextColumn Header="varav tänkande" Binding="{Binding Thinking, StringFormat=N0}" ElementStyle="{StaticResource MutedNumber}"/>
                                <DataGridTextColumn Header="Cacheläsning" Binding="{Binding CacheRead, StringFormat=N0}" ElementStyle="{StaticResource MutedNumber}"/>
                                <DataGridTextColumn Header="Cacheskrivning" Binding="{Binding CacheWrite, StringFormat=N0}" ElementStyle="{StaticResource MutedNumber}"/>
                                <DataGridTemplateColumn Header="API-pris" SortMemberPath="Cost" Width="130" CellTemplate="{StaticResource CostBarCell}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </ContentControl>

                    <!-- Who started whom, and which tools and skills each agent called, read from the logs. -->
                    <ContentControl Grid.Row="1" Style="{StaticResource OutlineCard}" Padding="16,12" Margin="0,14,0,0">
                        <DockPanel>
                            <TextBlock x:Name="ActivityCaption" DockPanel.Dock="Top" Style="{StaticResource Caption}" Margin="0,0,0,8"
                                       Text="Struktur, verktyg och skills"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="Activity">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="{Binding Indent}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- A line down from the parent, like a tree. -->
                                                <Border Width="2" Margin="0,0,10,0" Background="{StaticResource Accent}" Opacity="0.5"
                                                        Visibility="{Binding BranchVisibility}"/>
                                                <StackPanel Grid.Column="1" Margin="0,4,0,8">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock VerticalAlignment="Center">
                                                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/>
                                                            <Run Text="{Binding Summary, Mode=OneWay}" Foreground="{StaticResource Muted}" FontSize="12.5"/>
                                                        </TextBlock>
                                                        <Button Content="Visa uppdrag" Margin="12,0,0,0" Padding="8,1" FontSize="12.5"
                                                                Visibility="{Binding SubagentVisibility}" Click="ShowAgentPrompt_Click"
                                                                ToolTip="Prompten huvudsessionen skickade till agenten, läst ur loggen"/>
                                                        <Button Content="Visa definition" Margin="8,0,0,0" Padding="8,1" FontSize="12.5"
                                                                Visibility="{Binding SubagentVisibility}" IsEnabled="{Binding HasDefinition}"
                                                                Click="ShowDefinition_Click" ToolTip="{Binding DefinitionTip}" ToolTipService.ShowOnDisabled="True"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Allowed}" Visibility="{Binding AllowedVisibility}" Foreground="{StaticResource Faint}"
                                                               FontSize="12.5" TextWrapping="Wrap" Margin="0,2,0,0"
                                                               ToolTip="Enligt sessionens agentlista när körningen gjordes"/>
                                                    <ItemsControl ItemsSource="{Binding Skills}" Margin="0,4,0,0">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="{StaticResource Accent}" CornerRadius="3" Padding="7,2" Margin="0,2,6,2" ToolTip="Skill">
                                                                    <TextBlock Foreground="{StaticResource Background}" FontSize="12.5" Text="{Binding Text}"/>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <!-- One bar per tool, as long as its share of the agent's most used tool. -->
                                                    <ItemsControl ItemsSource="{Binding Tools}" Margin="0,4,0,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,1" Opacity="{Binding Opacity}">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="170"/>
                                                                        <ColumnDefinition Width="*" MaxWidth="400"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource Muted}" FontSize="12.5"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                    <Border Grid.Column="1" Background="{StaticResource Accent}" Opacity="0.55" CornerRadius="2"
                                                                            Height="9" RenderTransformOrigin="0,0.5">
                                                                        <Border.RenderTransform>
                                                                            <ScaleTransform ScaleX="{Binding Share}"/>
                                                                        </Border.RenderTransform>
                                                                    </Border>
                                                                    <TextBlock Grid.Column="2" Text="{Binding Count}" Style="{StaticResource Number}"
                                                                               FontSize="12.5" Margin="10,0,0,0" MinWidth="28"/>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </ContentControl>

                    <Button Grid.Row="2" Content="Stäng" HorizontalAlignment="Right" Margin="0,14,0,0" IsCancel="True" Click="Close_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
