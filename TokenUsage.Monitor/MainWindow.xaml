<Window x:Class="TokenUsage.Monitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TokenUsage.Monitor"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="TokenUsageMonitor" Width="1060" Height="720" MinWidth="560" MinHeight="460"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" StateChanged="Window_StateChanged"
        Background="{StaticResource Background}" Foreground="{StaticResource Text}" FontFamily="{StaticResource UiFont}" FontWeight="{StaticResource UiWeight}" FontSize="14" Language="sv-SE">
    <!-- Keeps dragging, double-click to maximize, Aero Snap and edge resizing without the system title bar. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Lighten the dark title bar a little rather than switching to another color. -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1FFFFFFF"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#33FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#B50F1D"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TabIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,1,8,0"/>
        </Style>

        <Style x:Key="SessionCell" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="ToolTip" Value="{Binding SessionToolTip}"/>
        </Style>
        <Style x:Key="SummaryValue" TargetType="TextBlock" BasedOn="{StaticResource FigureValue}">
            <Setter Property="FontSize" Value="22"/>
        </Style>
    </Window.Resources>

    <!-- Fallback frame for when Windows doesn't draw a rounded border (Windows 10); code-behind decides. -->
    <Border x:Name="WindowFrame" BorderBrush="{StaticResource WindowEdge}" BorderThickness="1">
        <Grid Background="{StaticResource Background}">
            <!-- The tabs sit in the title bar next to the title; the empty rest of that strip is the WindowChrome
                 caption, so it drags and double-click maximizes. -->
            <TabControl x:Name="Tabs" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,16"
                        SelectionChanged="Tabs_SelectionChanged">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="44"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Margin="16,0,120,0">
                                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{StaticResource Accent}"
                                           FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>
                                <TabPanel IsItemsHost="True" VerticalAlignment="Bottom"/>
                            </StackPanel>
                            <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="16,0">
                                <ContentPresenter ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </TabControl.Template>
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
                    </Style>
                </TabControl.ItemContainerStyle>

                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEC4A;" Style="{StaticResource TabIcon}"/>
                            <TextBlock Text="Gränser" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,20,0,0" MaxWidth="1100">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <local:LimitCard x:Name="FiveCard" Title="Femtimmarsgränsen"/>
                                <local:LimitCard x:Name="WeekCard" Grid.Column="2" Title="Veckogränsen"/>
                            </Grid>
                            <StackPanel x:Name="StatusLine" Orientation="Horizontal" Margin="4,16,4,4" HorizontalAlignment="Left"
                                        Background="Transparent" ToolTipService.InitialShowDelay="200">
                                <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource Faint}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="Status" Style="{StaticResource Caption}" Margin="8,0,0,0" Text="Läser data…"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE81C;" Style="{StaticResource TabIcon}"/>
                            <TextBlock Text="Körningar" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    <Grid Margin="0,16,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*" MinHeight="120"/>
                        </Grid.RowDefinitions>

                        <DockPanel>
                            <ComboBox x:Name="Period" Width="190" SelectedIndex="1" SelectionChanged="Period_SelectionChanged">
                                <ComboBoxItem Content="Senaste 24 timmarna" Tag="1"/>
                                <ComboBoxItem Content="Senaste 7 dagarna" Tag="7"/>
                                <ComboBoxItem Content="Senaste 30 dagarna" Tag="30"/>
                                <ComboBoxItem Content="Allt" Tag="0"/>
                            </ComboBox>
                            <ComboBox x:Name="SessionFilter" Width="300" Margin="8,0,0,0" DisplayMemberPath="Text"
                                      SelectionChanged="SessionFilter_SelectionChanged"/>
                            <Button Content="Uppdatera" Style="{StaticResource AccentButton}" Margin="8,0,0,0" Click="Refresh_Click"/>
                            <TextBlock x:Name="RunsSummary" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0"
                                       TextAlignment="Right" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>

                        <UniformGrid Grid.Row="1" Columns="3" Margin="-8,16,-8,16">
                            <ContentControl Style="{StaticResource OutlineCard}" Padding="18,14" Margin="8,0">
                                <StackPanel>
                                    <TextBlock x:Name="RunCount" Style="{StaticResource SummaryValue}" Text="–"/>
                                    <TextBlock Style="{StaticResource FigureLabel}" Text="körningar"/>
                                </StackPanel>
                            </ContentControl>
                            <ContentControl Style="{StaticResource OutlineCard}" Padding="18,14" Margin="8,0">
                                <StackPanel>
                                    <TextBlock x:Name="ResponseCount" Style="{StaticResource SummaryValue}" Text="–"/>
                                    <TextBlock Style="{StaticResource FigureLabel}" Text="svar"/>
                                </StackPanel>
                            </ContentControl>
                            <ContentControl Style="{StaticResource OutlineCard}" Padding="18,14" Margin="8,0">
                                <StackPanel>
                                    <TextBlock x:Name="CostTotal" Style="{StaticResource SummaryValue}" Text="–"/>
                                    <TextBlock Style="{StaticResource FigureLabel}" Text="API-pris"/>
                                </StackPanel>
                            </ContentControl>
                        </UniformGrid>

                        <ContentControl Grid.Row="2" Style="{StaticResource OutlineCard}" Padding="6,10,6,6">
                            <DataGrid x:Name="Runs" MouseDoubleClick="Runs_MouseDoubleClick"
                                      ContextMenuOpening="Runs_ContextMenuOpening" PreviewKeyDown="Runs_PreviewKeyDown">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem x:Name="ShowPromptItem" Header="Visa hela prompten" Click="ShowPrompt_Click"/>
                                        <MenuItem Header="Kopiera rad" InputGestureText="Ctrl+C" Click="CopyRow_Click"/>
                                        <MenuItem x:Name="CopyCellItem" Click="CopyCell_Click"/>
                                        <MenuItem x:Name="SessionFilterItem" Click="SessionFilterItem_Click"/>
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Start" Binding="{Binding Start, StringFormat='ddd d MMM HH:mm'}" SortMemberPath="Start"/>
                                    <DataGridTextColumn Header="Prompt" Binding="{Binding Label}" Width="*" MinWidth="220" ElementStyle="{StaticResource PromptCell}"/>
                                    <DataGridTextColumn Header="Session" Binding="{Binding Session}" Width="140" ElementStyle="{StaticResource SessionCell}"/>
                                    <DataGridTextColumn Header="Tid" Binding="{Binding Duration}" SortMemberPath="DurationSeconds" ElementStyle="{StaticResource MutedNumber}"/>
                                    <DataGridTextColumn Header="Svar" Binding="{Binding Responses, StringFormat=N0}" ElementStyle="{StaticResource Number}"/>
                                    <DataGridTextColumn Header="Utskrivet" Binding="{Binding Output, StringFormat=N0}" ElementStyle="{StaticResource Number}"/>
                                    <DataGridTextColumn Header="Cacheläsning" Binding="{Binding CacheRead, StringFormat=N0}" ElementStyle="{StaticResource MutedNumber}"/>
                                    <DataGridTextColumn Header="Cacheskrivning" Binding="{Binding CacheWrite, StringFormat=N0}" ElementStyle="{StaticResource MutedNumber}"/>
                                    <DataGridTemplateColumn Header="API-pris" SortMemberPath="Cost" Width="130" CellTemplate="{StaticResource CostBarCell}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </ContentControl>

                    </Grid>
                </TabItem>
            </TabControl>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="Minimera" Click="Minimize_Click"/>
                <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" ToolTip="Maximera"
                        Click="MaximizeRestore_Click"/>
                <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" ToolTip="Stäng" Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
